<!-- pages/rank/rank.wxml — 排名查询 · v4 竞争力阶梯 -->
<view class="container">

  <!-- 输入区（查询成功后隐藏，可点"重新查询"返回） -->
  <view class="card" wx:if="{{!result}}">
    <view class="card-title">排名查询</view>

    <view class="rank-field">
      <text class="rank-label">摇号次数</text>
      <input class="rank-input" type="number" value="{{times}}" bindinput="onTimesInput"
        placeholder="请输入摇号次数" />
    </view>

    <view class="rank-field">
      <text class="rank-label">注册时间</text>
      <view class="rank-time-row">
        <picker mode="date" value="{{regDate}}" start="2000-01-01" end="2026-12-31" bindchange="onDateChange">
          <view class="rank-picker">{{regDate}}</view>
        </picker>
        <picker mode="time" value="{{regTime}}" bindchange="onTimeChange">
          <view class="rank-picker">{{regTime}}</view>
        </picker>
        <input class="rank-input rank-input-sm" type="number" value="{{regSec}}" bindinput="onSecInput"
          placeholder="秒" maxlength="2" />
        <input class="rank-input rank-input-sm" type="number" value="{{regMs}}" bindinput="onMsInput"
          placeholder="毫秒" maxlength="3" />
      </view>
    </view>

    <view class="btn-primary {{loading ? 'rank-btn-disabled' : ''}}" bindtap="onQuery">
      {{loading ? '查询中...' : '查询排名'}}
    </view>
  </view>

  <!-- 结果区 -->
  <block wx:if="{{result}}">
    <view class="rank-reset" bindtap="onReset">重新查询</view>

    <!-- 排名卡片 -->
    <view class="card rank-rank-card">
      <view class="rank-rank-main">
        <text class="rank-rank-num">{{result.rank}}</text>
        <text class="rank-rank-suffix">名</text>
      </view>
      <view class="rank-rank-sub">共 {{result.total}} 人参与 · 前 {{result.user_pct}}%</view>
      <button class="rank-share-btn" open-type="share">分享这个结果</button>
    </view>

    <!-- 综合判词 -->
    <view class="rank-advice">
      <text class="rank-advice-label">结论</text>
      <text class="rank-advice-text">{{verdict}}</text>
    </view>
    <view class="rank-advice" wx:if="{{bandNote}}">
      <text class="rank-advice-label">口径</text>
      <text class="rank-advice-text">{{bandNote}}</text>
    </view>

    <!-- 前三推荐：本期车型 -->
    <block wx:if="{{topCards.length}}">
      <view class="card" wx:for="{{topCards}}" wx:for-item="rec" wx:key="bracket">
        <view class="rank-bk-head">
          <text class="rank-bk-title">★{{rec.star}} {{rec.bracket}}</text>
          <text class="tag rank-rec-strong">竞争力 {{rec.score_text}} · 近4期同类成交 {{rec.recent_orders}} 单</text>
        </view>
        <view class="rank-bk-current">
          <view class="rank-bk-top5-title">本期在售 · 起拍价最低 {{rec.cars.length}} 台（出价方式：直接顶格）</view>
          <view class="rank-car-row" wx:for="{{rec.cars}}" wx:for-item="m" wx:key="car_link"
            bindtap="onCarTap" data-link="{{m.car_link}}">
            <text class="rank-car-name">{{m.car_name}}</text>
            <text class="rank-car-times" wx:if="{{m.meta}}">{{m.meta}}</text>
            <text class="rank-car-price">起 {{m.start_text}}</text>
            <text class="rank-car-times">{{m.limit_text}}</text>
            <text class="rank-car-arrow">›</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 竞争力阶梯（全部档位，纯价格维度） -->
    <view class="card">
      <view class="card-title">竞争力阶梯（历史口径）</view>
      <view class="rank-ladder-row rank-ladder-head">
        <text class="rank-ladder-bk">档位</text>
        <text class="rank-ladder-col">竞争力分</text>
        <text class="rank-ladder-col">近4期获单</text>
        <text class="rank-ladder-col">本期在售</text>
        <text class="rank-ladder-last">判定</text>
      </view>
      <view class="rank-ladder-row {{item.pass ? '' : 'rank-ladder-dim'}}" wx:for="{{ladderRows}}" wx:key="bracket">
        <text class="rank-ladder-bk {{item.pass ? 'rank-ladder-bk-hot' : ''}}">{{item.bracket}}</text>
        <text class="rank-ladder-col">{{item.score_text}}</text>
        <text class="rank-ladder-col">{{item.recent_orders}}</text>
        <text class="rank-ladder-col">{{item.supply}}</text>
        <text class="rank-ladder-last">
          <text wx:if="{{item.star}}" class="rank-ladder-star">★{{item.star}}</text>
          <text wx:elif="{{item.noSupply}}" class="rank-ladder-no">无在售</text>
          <text wx:else class="rank-ladder-no">先例不足</text>
        </text>
      </view>
      <view class="empty" wx:if="{{!ladderRows.length}}">暂无档位数据</view>
    </view>

    <!-- 数据口径说明 -->
    <view class="card rank-rules">
      <view class="card-title">数据口径</view>
      <view class="rank-rules-line">· 车辆按公布的最高限价顶格成交（历史溢价恒为 1.50），最终归属由排序决定：摇号次数多者优先，同次数比注册时间先后</view>
      <view class="rank-rules-line">· 竞争力分：与你分位相近、排位不比你好的人（同类），近 4 期在其档位总成交中占的份额期均；只反映历史先例，不保证当期结果</view>
      <view class="rank-rules-line">· 判定线：竞争力分 ≥ 0.3% 或 近4期同类获单 ≥ 3；通过者按价格升序给出前三推荐，出价方式统一直接顶格</view>
    </view>
  </block>

</view>
