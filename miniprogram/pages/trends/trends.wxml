<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:else>
    <!-- 我的速览 -->
    <view class="card trend-brief">
      <block wx:if="{{myBrief}}">
        <view class="trend-brief-main">
          <view class="trend-brief-title">我的速览</view>
          <view class="trend-brief-text">上次查询 {{myBrief.rankText}}{{myBrief.pct ? '（前 ' + myBrief.pct + '%）' : ''}} · 摇号 {{myBrief.times}} 次</view>
        </view>
        <view class="trend-brief-btn" bindtap="goRankFull">查看完整推荐</view>
      </block>
      <block wx:else>
        <view class="trend-brief-main">
          <view class="trend-brief-title">我的速览</view>
          <view class="trend-brief-text">还没查过排名，先算算你的名次</view>
        </view>
        <view class="trend-brief-btn" bindtap="goRankTab">去查排名</view>
      </block>
    </view>

    <!-- 本期车源概览 -->
    <view class="card" wx:if="{{condition}}">
      <view class="card-title">本期车源概览（{{currentPeriod}}）</view>
      <view class="trend-stat-row"><text>在售车辆</text><text>{{condition.total}} 台</text></view>
      <view class="trend-stat-row"><text>已有里程数据</text><text>{{condition.with_mileage}} 台</text></view>
      <view class="trend-stat-row"><text>缺行驶证 / 登记证</text><text>{{condition.no_license}} / {{condition.no_registration}} 台</text></view>
      <view class="trend-stat-row"><text>缺车牌 / 钥匙</text><text>{{condition.no_plate}} / {{condition.no_key}} 台</text></view>
      <view class="trend-stat-row"><text>抵押车辆</text><text>{{condition.mortgaged}} 台</text></view>
      <view class="trend-stat-row"><text>平均额外费用</text><text>{{condition.avg_extra_fee}} 元</text></view>
      <view class="trend-insight">历史 {{history.winners}} 条中拍记录（{{history.periods}} 期）只用于排名页推荐，本页仅统计本期在售车辆</view>
    </view>

    <!-- 本期起拍价档位分布 -->
    <view class="card">
      <view class="card-title">起拍价档位分布</view>
      <view wx:if="{{priceDist.length}}" class="chart-wrap chart-tall">
        <ec-canvas id="price-chart" canvas-id="price-chart" ec="{{priceEc}}"></ec-canvas>
      </view>
      <view wx:else class="empty">暂无数据</view>
    </view>

    <!-- 本期里程分布 -->
    <view class="card">
      <view class="card-title">里程分布</view>
      <view wx:if="{{mileageDist.length}}">
        <view class="bar-row" wx:for="{{mileageDist}}" wx:key="range">
          <view class="bar-label">{{item.range}}</view>
          <view class="bar-track">
            <view class="bar-fill bar-red" style="width: {{item.percent}}%"></view>
          </view>
          <view class="bar-count">{{item.count}}</view>
        </view>
      </view>
      <view wx:else class="empty">暂无数据</view>
    </view>

    <!-- 品牌 Top -->
    <view class="card">
      <view class="card-title">品牌 Top</view>
      <view wx:if="{{brandTop.length}}">
        <view class="rank-row" wx:for="{{brandTop}}" wx:key="brand">
          <view class="rank-no {{index < 3 ? 'rank-hot' : ''}}">{{index + 1}}</view>
          <view class="rank-name">{{item.brand}}</view>
          <view class="rank-bar">
            <view class="rank-fill" style="width: {{item.percent}}%"></view>
          </view>
          <view class="rank-count">{{item.count}}</view>
        </view>
      </view>
      <view wx:else class="empty">暂无数据</view>
    </view>

    <!-- 法院 Top -->
    <view class="card" wx:if="{{courtTop.length}}">
      <view class="card-title">法院 Top</view>
      <view class="rank-row" wx:for="{{courtTop}}" wx:key="court">
        <view class="rank-no {{index < 3 ? 'rank-hot' : ''}}">{{index + 1}}</view>
        <view class="rank-name">{{item.court}}</view>
        <view class="rank-bar">
          <view class="rank-fill" style="width: {{item.percent}}%"></view>
        </view>
        <view class="rank-count">{{item.count}}</view>
      </view>
    </view>

    <!-- 燃料 / 排放 -->
    <view class="card" wx:if="{{fuelDist.length || emissionDist.length}}">
      <view class="card-title">燃料 / 排放</view>
      <view class="trend-stat-row" wx:for="{{fuelDist}}" wx:key="fuel_type">
        <text>{{item.fuel_type}}</text><text>{{item.count}} 台</text>
      </view>
      <view class="trend-stat-row" wx:for="{{emissionDist}}" wx:key="emission">
        <text>{{item.emission}}</text><text>{{item.count}} 台</text>
      </view>
    </view>

    <!-- 底部入口 -->
    <view class="card">
      <view class="trend-actions">
        <view class="trend-action-btn" bindtap="goCarsTab">筛选本期全部车辆</view>
        <view class="trend-action-btn" bindtap="goRankTab">查排名看推荐</view>
      </view>
    </view>
  </block>
</view>
