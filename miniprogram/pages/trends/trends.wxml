<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:else>
    <!-- 我的速览 -->
    <view class="card trend-brief">
      <block wx:if="{{myBrief}}">
        <view class="trend-brief-main">
          <view class="trend-brief-title">我的速览</view>
          <view class="trend-brief-text">上次查询 {{myBrief.rankText}}{{myBrief.pct ? '（前 ' + myBrief.pct + '%）' : ''}} · 摇号 {{myBrief.times}} 次</view>
        </view>
        <view class="trend-brief-btn" bindtap="goRankFull">查看完整推荐</view>
      </block>
      <block wx:else>
        <view class="trend-brief-main">
          <view class="trend-brief-title">我的速览</view>
          <view class="trend-brief-text">还没查过排名，先算算你的名次</view>
        </view>
        <view class="trend-brief-btn" bindtap="goRankTab">去查排名</view>
      </block>
    </view>

    <!-- 价位段决策图：柱=该档成交数量，折线=平均摇号次数，参考线=你的次数 -->
    <view class="card">
      <view class="card-title">价位段决策图</view>
      <view wx:if="{{bracketDist.length}}" class="chart-wrap chart-tall">
        <ec-canvas id="decision-chart" canvas-id="decision-chart" ec="{{decisionEc}}"></ec-canvas>
      </view>
      <view wx:else class="empty">暂无数据</view>
    </view>

    <!-- 成交者参与次数分布 -->
    <view class="card">
      <view class="card-title">成交者参与次数分布</view>
      <view class="trend-insight" wx:if="{{timesGe80Pct !== null}}">{{timesGe80Pct}}% 的成交者参与次数 ≥ 80 次（中位数 {{timesMedian}} 次）——次数不够时，优先看门槛更低的档位</view>
      <view wx:if="{{timesDist.length}}">
        <view class="bar-row" wx:for="{{timesDist}}" wx:key="range">
          <view class="bar-label">{{item.range}}</view>
          <view class="bar-track">
            <view class="bar-fill bar-red" style="width: {{item.percent}}%"></view>
          </view>
          <view class="bar-count">{{item.count}}</view>
        </view>
      </view>
      <view wx:else class="empty">暂无数据</view>
    </view>

    <!-- 品牌 Top -->
    <view class="card">
      <view class="card-title">品牌 Top</view>
      <view wx:if="{{brandTop.length}}">
        <view class="rank-row" wx:for="{{brandTop}}" wx:key="brand">
          <view class="rank-no {{index < 3 ? 'rank-hot' : ''}}">{{index + 1}}</view>
          <view class="rank-name">{{item.brand}}</view>
          <view class="rank-bar">
            <view class="rank-fill" style="width: {{item.percent}}%"></view>
          </view>
          <view class="rank-count">{{item.count}}</view>
        </view>
      </view>
      <view wx:else class="empty">暂无数据</view>
    </view>

    <!-- 数据概览 -->
    <view class="card" wx:if="{{stats}}">
      <view class="card-title">数据概览</view>
      <view class="trend-stat-row"><text>覆盖期次</text><text>{{stats.periods}} 期</text></view>
      <view class="trend-stat-row"><text>车辆档案</text><text>{{stats.cars}} 台</text></view>
      <view class="trend-stat-row"><text>成交记录</text><text>{{stats.winners}} 条</text></view>
    </view>
  </block>
</view>